# Copy to .env and adjust. Either set DATABASE_URL, or the MYSQL_* parts below.

# DATABASE_URL=mysql+pymysql://seatuser:seatpass@127.0.0.1:3306/seatbooking?charset=utf8mb4

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=seatuser
MYSQL_PASSWORD=seatpass
MYSQL_DATABASE=seatbooking

# Origins allowed to call this API from a browser (comma separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Create tables at startup. Fine for demos; run schema.sql in production instead.
AUTO_CREATE_TABLES=true

# Log a stand-in confirmation "email" after each successful booking.
MOCK_EMAIL_ENABLED=true

# Guard rails
MAX_ROWS_PER_EVENT=50
MAX_COLUMNS_PER_EVENT=60
MAX_SEATS_PER_EVENT=2000
MAX_SEATS_PER_BOOKING=10
