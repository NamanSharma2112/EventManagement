# Copy to .env and adjust. Either set DATABASE_URL, or the MYSQL_* parts below.

# DATABASE_URL=mysql+pymysql://seatuser:seatpass@127.0.0.1:3306/seatbooking?charset=utf8mb4

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=seatuser
MYSQL_PASSWORD=seatpass
MYSQL_DATABASE=seatbooking

# Origins allowed to call this API from a browser (comma separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Create tables at startup. Fine for demos; run schema.sql in production instead.
AUTO_CREATE_TABLES=true

# Log a stand-in confirmation "email" after each successful booking.
MOCK_EMAIL_ENABLED=true

# Guard rails
MAX_ROWS_PER_EVENT=50
MAX_COLUMNS_PER_EVENT=60
MAX_SEATS_PER_EVENT=2000
MAX_SEATS_PER_BOOKING=10

# --- Auth -------------------------------------------------------------------
# CHANGE THIS. Anyone who knows it can mint an admin token.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me-before-deploying
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14

# Admin endpoints require an ADMIN token. Set false for the brief's
# no-login admin demo.
REQUIRE_ADMIN_AUTH=true

# Seeded on first startup only; skipped once the account exists.
CREATE_BOOTSTRAP_ADMIN=true
BOOTSTRAP_ADMIN_EMAIL=admin@seatbook.dev
BOOTSTRAP_ADMIN_PASSWORD=admin12345
BOOTSTRAP_ADMIN_NAME=Demo Admin
